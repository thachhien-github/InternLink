{
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:7109" },
        { "key": "token", "value": "" }
    ],
    "info": {
        "name": "InternLink API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "description": "InternLink API — Auth, Lecturer workflow, Admin module (SuperAdmin)."
    },
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login (superadmin)",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"username\":\"superadmin\",\"password\":\"Password123!\"}"
                        },
                        "url": "{{baseUrl}}/api/Auth/login"
                    }
                },
                {
                    "name": "Forgot Password",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"email\":\"student1@internlink.test\"}"
                        },
                        "url": "{{baseUrl}}/api/Auth/forgot-password"
                    }
                },
                {
                    "name": "Reset Password",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"token\":\"PASTE_TOKEN_FROM_LOG\",\"newPassword\":\"NewPass456!\"}"
                        },
                        "url": "{{baseUrl}}/api/Auth/reset-password"
                    }
                },
                {
                    "name": "Me",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": "{{baseUrl}}/api/Auth/me"
                    }
                }
            ]
        },
        {
            "name": "Admin",
            "item": [
                {
                    "name": "List Users",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": "{{baseUrl}}/api/Admin/users?skip=0&take=50"
                    }
                },
                {
                    "name": "List Students",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": "{{baseUrl}}/api/Admin/students?skip=0&take=50"
                    }
                },
                {
                    "name": "List Companies",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": "{{baseUrl}}/api/Admin/companies?skip=0&take=50"
                    }
                },
                {
                    "name": "Bulk Assign Students",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{token}}" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"lecturerId\": \"LECTURER_GUID\",\n  \"studentIds\": [\"STUDENT_GUID_1\", \"STUDENT_GUID_2\"]\n}"
                        },
                        "url": "{{baseUrl}}/api/Admin/assignments"
                    }
                },
                {
                    "name": "Assignments by Lecturer",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": "{{baseUrl}}/api/Admin/assignments/by-lecturer/LECTURER_GUID"
                    }
                },
                {
                    "name": "Test Email",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{token}}" },
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"toEmail\":\"test@demo.edu.vn\",\"fullName\":\"Test User\",\"role\":0}"
                        },
                        "url": "{{baseUrl}}/api/Admin/email/test"
                    }
                }
            ]
        },
        {
            "name": "Lecturer",
            "item": [
                {
                    "name": "Login (lecturer1)",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"username\":\"lecturer1\",\"password\":\"Password123!\"}"
                        },
                        "url": "{{baseUrl}}/api/Auth/login"
                    }
                },
                {
                    "name": "My Internships",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": "{{baseUrl}}/api/Lecturer/internships"
                    }
                },
                {
                    "name": "Export End Of Term",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": "{{baseUrl}}/api/Lecturer/export/end-of-term"
                    }
                }
            ]
        },
        {
            "name": "Read-only (Lecturer)",
            "item": [
                {
                    "name": "GET Students",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": "{{baseUrl}}/api/Student"
                    }
                },
                {
                    "name": "GET Companies",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                        "url": "{{baseUrl}}/api/Company"
                    }
                }
            ]
                 }
             ]
}
